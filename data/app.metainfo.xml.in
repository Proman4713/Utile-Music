<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>@app_id@</id>
    <name>Music</name>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <summary>Enjoy listening to local music elegantly</summary>

    <developer id="com.github.proman4713">
        <name translate="no">Aaser Abd-el Sabour</name>
    </developer>
    <update_contact>proman4713@gmail.com</update_contact>

    <url type="homepage">https://github.com/Proman4713/Utile-Music</url>
    <url type="bugtracker">https://utile-os-web.mailworker.workers.dev</url>
    <url type="translate">https://github.com/Proman4713/Utile-Music</url>

    <launchable type="desktop-id">@app_id@.desktop</launchable>
    <provides>@app_id@.desktop</provides>
    <content_rating type="oars-1.1"/>
    <translation type="gettext">utile-music</translation>

    <description>
                <p>Utile Music is an elegant music player for Linux designed for Utile OS.</p>
    </description>

    <branding>
        <color type="primary" scheme_preference="light">#d6f6d6</color>
        <color type="primary" scheme_preference="dark">#266626</color>
    </branding>

	<!-- TODO: Change these-->
    <screenshots>
        <screenshot type="default">
            <caption>Main window</caption>
            <image>https://gitlab.gnome.org/neithern/screenshots/-/raw/main/g4music/window.png</image>
        </screenshot>
        <screenshot>
            <caption>Albums view</caption>
            <image>https://gitlab.gnome.org/neithern/screenshots/-/raw/main/g4music/albums.png</image>
        </screenshot>
        <screenshot>
            <caption>Playing view</caption>
            <image>https://gitlab.gnome.org/neithern/screenshots/-/raw/main/g4music/playing.png</image>
        </screenshot>
        <screenshot>
            <caption>Playlist view</caption>
            <image>https://gitlab.gnome.org/neithern/screenshots/-/raw/main/g4music/playlist.png</image>
        </screenshot>
    </screenshots>

    <releases>
        <release version="1.3.1" date="2026-09-04">
            <description translate="no">
                <p>Fix app icon rendering issue.</p>
            </description>
        </release>
        <release version="1.3.0" date="2026-09-04">
            <description translate="no">
                <p>Update logo.</p>
				<p>This icon design update is aimed to better match what Utile OS as a whole aims to look like with smoother and more immersive iconography. Of course, the rest of the Yaru theme, which we inherit, doesn't match, but having a direction to go in should help us incrementally improve the overall look and feel.</p>
            </description>
        </release>
        <release version="1.2.0" date="2026-09-04">
            <description translate="no">
                <p>Update logo.</p>
            </description>
        </release>
        <release version="1.1.0" date="2026-09-04">
            <description translate="no">
                <p>Utile Music rebrand.</p>
            </description>
        </release>
        <release version="1.0.0" date="2026-09-04">
            <description translate="no">
                <p>First release.</p>
            </description>
        </release>
    </releases>

    <requires>
        <display_length compare="ge">360</display_length>
    </requires>

    <supports>
        <control>keyboard</control>
        <control>pointing</control>
        <control>touch</control>
    </supports>

</component>
