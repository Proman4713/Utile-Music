<Project xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:gnome="http://api.gnome.org/doap-extensions#"
         xmlns="http://usefulinc.com/ns/doap#">

  <name xml:lang="en">Utile Music</name>
  <shortdesc xml:lang="en">Play your music elegantly</shortdesc>
  <description xml:lang="en">An elegant music player for Linux based on Gapless designed for Utile OS.</description>
  <category rdf:resource="http://api.gnome.org/doap-extensions#apps" />
  <homepage rdf:resource="https://github.com/Proman4713/Utile-Music" />
  <bug-database rdf:resource="https://utile-os-web.mailworker.workers.dev" />

  <programming-language>Vala</programming-language>
  <platform>GTK 4</platform>
  <platform>Libadwaita</platform>

  <maintainer>
    <foaf:Person>
      <foaf:name>Aaser Abd-el Sabour</foaf:name>
      <foaf:mbox rdf:resource="mailto:proman4713@gmail.com" />
      <foaf:account>
        <foaf:OnlineAccount>
          <foaf:accountServiceHomepage rdf:resource="https://github.com"/>
          <foaf:accountName>Proman4713</foaf:accountName>
        </foaf:OnlineAccount>
      </foaf:account>
    </foaf:Person>
  </maintainer>
</Project>
